APP_ENV=development
DATABASE_URL=postgresql+asyncpg://agentshield:agentshield_local_password@localhost:5432/agentshield
CORS_ORIGINS=http://localhost:3000
# Default is deterministic and completely offline. Set to ollama to use a local model server.
MODEL_PROVIDER=rules
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=60
RISK_CRITICAL_THRESHOLD=80
